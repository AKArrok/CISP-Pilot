    "id": "ac-8-new-05",
    "question": "告知是否需要考虑多语言用户？",
    "events": [
      {
        "type": "intent",
        "intent": "knowledge"
      },
      {
        "type": "contexts",
        "contexts": [
          {
            "source": "NIST SP 800-53 5.2.0 OSCAL",
